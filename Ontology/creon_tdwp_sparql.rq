# ═══════════════════════════════════════════════════════════════════
#  CreOn-TDWP: SPARQL Unit Tests
#  Run against: Apache Jena Fuseki or any SPARQL 1.1 endpoint
#  Load: creon_tdwp.ttl + CreOn core ontology
# ═══════════════════════════════════════════════════════════════════

PREFIX :       <http://creon-film.org/ontology/tdwp#>
PREFIX creon:  <http://creon.org/ontology#>
PREFIX dul:    <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>


# ───────────────────────────────────────────────────────────────────
#  CQ1 — Who are the agents of the 2006 production?
#  Expected: DavidFrankel, AlineBroshMcKenna, MerylStreep, AnneHathaway
# ───────────────────────────────────────────────────────────────────

SELECT DISTINCT ?agent ?label WHERE {
    :TDWP2006_Production creon:hasAgent ?agent .
    OPTIONAL { ?agent rdfs:label ?label }
}
ORDER BY ?label


# ───────────────────────────────────────────────────────────────────
#  CQ2 — Which agents participated in BOTH the 2006 and 2026 processes?
#  Expected: DavidFrankel, AlineBroshMcKenna, MerylStreep, AnneHathaway
# ───────────────────────────────────────────────────────────────────

SELECT DISTINCT ?agent ?label WHERE {
    :TDWP2006_Production creon:hasAgent ?agent .
    :TDWP2026_Production creon:hasAgent ?agent .
    OPTIONAL { ?agent rdfs:label ?label }
}
ORDER BY ?label


# ───────────────────────────────────────────────────────────────────
#  CQ3 — What CreativityPress contexts are associated with each film's production?
#  Expected: PrintMediaEra_2004 → 2006; StreamingEra_2024 → 2026
# ───────────────────────────────────────────────────────────────────

SELECT DISTINCT ?process ?processLabel ?press ?pressLabel WHERE {
    ?process a creon:PersonalProcess ;
             creon:hasPress ?press .
    OPTIONAL { ?process rdfs:label ?processLabel }
    OPTIONAL { ?press   rdfs:label ?pressLabel }
}
ORDER BY ?processLabel


# ───────────────────────────────────────────────────────────────────
#  CQ4 — How many FruitionContexts does the 2006 film have?
#  Expected: 3
# ───────────────────────────────────────────────────────────────────

SELECT (COUNT(DISTINCT ?ctx) AS ?count) WHERE {
    :TDWP_Film_2006 :hasReceptionContext ?ctx .
}


# ───────────────────────────────────────────────────────────────────
#  CQ5 — What interpretive frames are applied to the 2006 film,
#         and in which reception years?
#  Expected: AmbitionAndSuccess(2006), WorkplaceAbuse(2017), NostalgiaForPrintEra(2026)
# ───────────────────────────────────────────────────────────────────

SELECT ?year ?frameLabel WHERE {
    :TDWP_Film_2006 :hasReceptionContext ?ctx .
    ?ctx :hasReceptionYear ?year ;
         :interpretedThrough ?frame .
    OPTIONAL { ?frame rdfs:label ?frameLabel }
}
ORDER BY ?year


# ───────────────────────────────────────────────────────────────────
#  CQ6 — Does the fashion industry function as social domain
#         for both creativity situations?
#  Expected: TDWP_CreativitySituation_2006, TDWP_CreativitySituation_2026
# ───────────────────────────────────────────────────────────────────

SELECT DISTINCT ?situation ?label WHERE {
    ?situation a creon:CreativitySituation ;
               :hasSocialDomain :FashionIndustry .
    OPTIONAL { ?situation rdfs:label ?label }
}


# ───────────────────────────────────────────────────────────────────
#  CQ7 — What triggered the reception shifts for the 2006 film?
#         (chains of shifts and their press triggers)
# ───────────────────────────────────────────────────────────────────

SELECT ?shift ?shiftLabel ?fromCtx ?toCtx ?press ?pressLabel WHERE {
    ?shift a :ReceptionShift ;
           :shiftsInterpretationOf :TDWP_Film_2006 ;
           :fromContext ?fromCtx ;
           :toContext   ?toCtx ;
           :triggeredByPress ?press .
    OPTIONAL { ?shift rdfs:label ?shiftLabel }
    OPTIONAL { ?press rdfs:label ?pressLabel }
}
ORDER BY ?fromCtx


# ───────────────────────────────────────────────────────────────────
#  NCQ1 — Is a FruitionContext itself a CreativeProduct?
#  Expected: false (ASK returns false)
# ───────────────────────────────────────────────────────────────────

ASK {
    :Reception_2017_PostMeToo a creon:CreativeProduct .
}
# → Expected: false


# ───────────────────────────────────────────────────────────────────
#  NCQ2 — Is the streaming platform a PersonalProcess agent?
#  Expected: false (ASK returns false)
# ───────────────────────────────────────────────────────────────────

ASK {
    :StreamingEra_2024 a dul:NaturalPerson .
}
# → Expected: false


# ───────────────────────────────────────────────────────────────────
#  NCQ3 — Is the 2026 film's budget a CreativeProduct?
#  Expected: false (ASK returns false)
# ───────────────────────────────────────────────────────────────────

ASK {
    :TDWP2026_Production :hasBudgetUSD ?budget .
    ?budget a creon:CreativeProduct .
}
# → Expected: false


# ═══════════════════════════════════════════════════════════════════
#  BONUS QUERY — full opera aperta chain for the 2006 film
#  Shows the complete timeline of reception shifts
# ═══════════════════════════════════════════════════════════════════

SELECT ?year ?frameLabel ?shiftLabel WHERE {
    :TDWP_Film_2006 :hasReceptionContext ?ctx .
    ?ctx :hasReceptionYear ?year ;
         :interpretedThrough ?frame .
    OPTIONAL { ?frame rdfs:label ?frameLabel }
    OPTIONAL {
        ?shift :toContext ?ctx ;
               rdfs:label ?shiftLabel .
    }
}
ORDER BY ?year
