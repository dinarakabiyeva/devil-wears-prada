@prefix creon: <http://creon.org/ontology#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dul: <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tdwp: <http://creon-film.org/ontology/tdwp#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://creon-film.org/ontology/tdwp> a owl:Ontology ;
    dc:creator "University of Bologna — Knowledge Engineering 2025/2026" ;
    dc:description """Extension of the CreOn ontology modeling creativity
    across The Devil Wears Prada (2006) and its sequel (2026).
    Introduces FruitionContext, ReceptionShift, MediaIndustryPress,
    SequelProcess, FilmRole, FashionCreativeProduct, CulturalPressEvent
    and related subclasses to address opera aperta and temporal reception.""" ;
    dc:title "CreOn-TDWP: Fashion Film Creativity Extension" ;
    owl:versionInfo "2.0.0" .

tdwp:Cerulean_Scene a creon:CreativeProduct ;
    rdfs:label "The Cerulean Belt Speech (scene)"@en ;
    rdfs:comment "The iconic scene that became a cultural reference about fashion industry power.",
        "Iconic scene — cultural reference about fashion industry power"@en .

tdwp:Frame_FashionAsFeminism a tdwp:FeministFrame ;
    rdfs:label "Fashion as feminist self-expression"@en ;
    rdfs:comment "Reading of Andy's transformation as feminist agency rather than capitulation.",
        "Andy's transformation as feminist agency"@en .

tdwp:LuxuryFashionHouse a dul:SocialObject ;
    rdfs:label "Luxury Fashion House"@en ;
    rdfs:comment "High-end fashion brands (Chanel, Dior, Prada) featured in the films.",
        "High-end fashion brands (Chanel Dior Prada) in the films"@en .

tdwp:Miranda_Priestly_Character a creon:CreativeProduct ;
    rdfs:label "Miranda Priestly (character)"@en ;
    rdfs:comment "The fictional character: a CreativeProduct that became a cultural archetype.",
        "Cultural archetype derived from the film"@en .

tdwp:Novel_CreativitySituation a creon:CreativitySituation ;
    rdfs:label "Creativity situation Source Novel 2003"@en,
        "Creativity situation — Source Novel 2003"@en ;
    tdwp:hasSocialDomain tdwp:FashionIndustry ;
    creon:involves tdwp:TDWP_SourceNovel,
        tdwp:Weisberger_NovelWriting .

tdwp:OscarsSoWhite_2016 a tdwp:SocialMovementPress ;
    rdfs:label "#OscarsSoWhite (2016)"@en ;
    rdfs:comment "Diversity debate in Hollywood affecting how prestige films are received.",
        "Diversity debate in Hollywood"@en .

tdwp:PoliticalPressEvent a owl:Class ;
    rdfs:label "Political Press Event"@en ;
    rdfs:comment "A political event acting as CreativityPress on creative reception." ;
    rdfs:subClassOf tdwp:CulturalPressEvent .

tdwp:Shift_2006_to_SocialMedia a tdwp:TechnologicalShift ;
    rdfs:label "Shift theatrical → social media meme culture"@en,
        "Shift: theatrical → social media meme culture"@en ;
    tdwp:fromContext tdwp:Reception_2006_Theatrical ;
    tdwp:shiftsInterpretationOf tdwp:TDWP_Film_2006 ;
    tdwp:toContext tdwp:Reception_2010s_SocialMedia ;
    tdwp:triggeredByPress tdwp:SocialMediaEra_2010s .

tdwp:Shift_PostCOVID_to_2026 a tdwp:TechnologicalShift ;
    rdfs:label "Shift nostalgia → print era document (2026)"@en,
        "Shift: nostalgia → print era document (2026)"@en ;
    tdwp:fromContext tdwp:Reception_2021_PostCOVID ;
    tdwp:shiftsInterpretationOf tdwp:TDWP_Film_2006 ;
    tdwp:toContext tdwp:Reception_2026_PostSequel ;
    tdwp:triggeredByPress tdwp:StreamingEra_2024 .

tdwp:Shift_PostMeToo_to_PostCOVID a tdwp:HistoricalShift ;
    rdfs:label "Shift abuse frame → nostalgia post-COVID"@en,
        "Shift: abuse frame → nostalgia (post-COVID)"@en ;
    tdwp:fromContext tdwp:Reception_2017_PostMeToo ;
    tdwp:shiftsInterpretationOf tdwp:TDWP_Film_2006 ;
    tdwp:toContext tdwp:Reception_2021_PostCOVID ;
    tdwp:triggeredByPress tdwp:PostCOVID_Cinema_2021 .

tdwp:Shift_SocialMedia_to_PostMeToo a tdwp:SocialMovementShift ;
    rdfs:label "Shift meme culture → workplace abuse frame"@en,
        "Shift: meme culture → workplace abuse frame"@en ;
    tdwp:fromContext tdwp:Reception_2010s_SocialMedia ;
    tdwp:shiftsInterpretationOf tdwp:TDWP_Film_2006 ;
    tdwp:toContext tdwp:Reception_2017_PostMeToo ;
    tdwp:triggeredByPress tdwp:MeTooMovement_2017 .

tdwp:TDWP_CreativitySituation_2006 a creon:CreativitySituation ;
    rdfs:label "Creativity situation TDWP 2006"@en,
        "Creativity situation — TDWP 2006"@en ;
    tdwp:hasSocialDomain tdwp:FashionIndustry ;
    creon:involves tdwp:TDWP2006_Production,
        tdwp:TDWP_Film_2006 .

tdwp:TDWP_CreativitySituation_2026 a creon:CreativitySituation ;
    rdfs:label "Creativity situation TDWP 2026"@en,
        "Creativity situation — TDWP 2026"@en ;
    tdwp:hasSocialDomain tdwp:FashionIndustry,
        tdwp:StreamingIndustry ;
    creon:involves tdwp:TDWP2026_Production,
        tdwp:TDWP_Film_2026 .

tdwp:adaptedFrom a owl:ObjectProperty ;
    rdfs:label "adapted from"@en ;
    rdfs:domain tdwp:FashionFilm ;
    rdfs:range tdwp:SourceNovel .

tdwp:hasBoxOfficeUSD a owl:DatatypeProperty ;
    rdfs:label "has box office (USD)"@en ;
    rdfs:domain tdwp:FashionFilm ;
    rdfs:range xsd:integer .

tdwp:hasBudgetUSD a owl:DatatypeProperty ;
    rdfs:label "has budget (USD)"@en ;
    rdfs:domain creon:PersonalProcess ;
    rdfs:range xsd:integer .

tdwp:hasDistributionChannel a owl:ObjectProperty ;
    rdfs:label "has distribution channel"@en ;
    rdfs:domain creon:CreativeProduct ;
    rdfs:range tdwp:MediaIndustryPress .

tdwp:hasDurationMinutes a owl:DatatypeProperty ;
    rdfs:label "has duration (minutes)"@en ;
    rdfs:domain tdwp:FashionFilm ;
    rdfs:range xsd:integer .

tdwp:hasFilmRole a owl:ObjectProperty ;
    rdfs:label "has film role"@en ;
    rdfs:domain dul:NaturalPerson ;
    rdfs:range tdwp:FilmRole .

tdwp:hasProductionYear a owl:DatatypeProperty ;
    rdfs:label "has production year"@en ;
    rdfs:domain creon:PersonalProcess ;
    rdfs:range xsd:gYear .

tdwp:hasReceptionYear a owl:DatatypeProperty ;
    rdfs:label "has reception year"@en ;
    rdfs:domain tdwp:FruitionContext ;
    rdfs:range xsd:gYear .

tdwp:hasReleaseYear a owl:DatatypeProperty ;
    rdfs:label "has release year"@en ;
    rdfs:domain creon:CreativeProduct ;
    rdfs:range xsd:gYear .

tdwp:hasSocialDomain a owl:ObjectProperty ;
    rdfs:label "has social domain"@en ;
    rdfs:domain creon:CreativitySituation ;
    rdfs:range dul:SocialObject .

tdwp:interpretedThrough a owl:ObjectProperty ;
    rdfs:label "interpreted through"@en ;
    rdfs:domain tdwp:FruitionContext ;
    rdfs:range tdwp:ConceptualInterpretiveFrame .

tdwp:precedesContext a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes context"@en ;
    rdfs:domain tdwp:FruitionContext ;
    rdfs:range tdwp:FruitionContext .

tdwp:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by"@en ;
    rdfs:domain creon:CreativeProduct ;
    rdfs:range creon:PersonalProcess .

tdwp:triggeredByPress a owl:ObjectProperty ;
    rdfs:label "triggered by press"@en ;
    rdfs:domain tdwp:ReceptionShift ;
    rdfs:range creon:CreativityPress .

tdwp:ActorRole a owl:Class ;
    rdfs:label "Actor Role"@en ;
    rdfs:subClassOf tdwp:FilmRole .

tdwp:Audience_2006_Critics a tdwp:CriticalAudience ;
    rdfs:label "Film critics 2006"@en ;
    rdfs:comment "Professional film critics at original release"@en .

tdwp:Audience_2006_Theatrical a tdwp:TheatricalAudience ;
    rdfs:label "Theatrical audience 2006"@en ;
    rdfs:comment "General theatrical audiences at original release"@en .

tdwp:Audience_2010s_Millennials a tdwp:StreamingAudience ;
    rdfs:label "Millennial rewatch audience (2010s)"@en ;
    rdfs:comment "Millennials discovering film via streaming/DVD"@en .

tdwp:Audience_2026_Critics a tdwp:CriticalAudience ;
    rdfs:label "Film critics — sequel premiere 2026"@en ;
    rdfs:comment "Professional critics reviewing the 2026 sequel"@en .

tdwp:Audience_PostCOVID a tdwp:CasualRewatchAudience ;
    rdfs:label "Post-COVID rewatch audience (2021)"@en ;
    rdfs:comment "Audiences rewatching comfort films during/after pandemic"@en .

tdwp:Audience_PostMeToo a tdwp:CriticalAudience ;
    rdfs:label "Socially aware audience post-2017"@en ;
    rdfs:comment "Audience applying feminist/labour lens post-MeToo"@en .

tdwp:CareerNarrativeFrame a owl:Class ;
    rdfs:label "Career Narrative Frame"@en ;
    rdfs:comment "Interpretation as story about professional ambition and career choices." ;
    rdfs:subClassOf tdwp:ConceptualInterpretiveFrame .

tdwp:CasualRewatchAudience a owl:Class ;
    rdfs:label "Casual Rewatch Audience"@en ;
    rdfs:comment "Audience watching the film again years after original release." ;
    rdfs:subClassOf tdwp:AudienceType .

tdwp:DirectSequel a owl:Class ;
    rdfs:label "Direct Sequel Process"@en ;
    rdfs:comment "A sequel that continues the narrative of the original." ;
    rdfs:subClassOf tdwp:SequelProcess .

tdwp:DirectorRole a owl:Class ;
    rdfs:label "Director Role"@en ;
    rdfs:subClassOf tdwp:FilmRole .

tdwp:EmilyBlunt a dul:NaturalPerson ;
    rdfs:label "Emily Blunt"@en ;
    tdwp:hasFilmRole tdwp:Role_LeadActor ;
    creon:hasAgent tdwp:TDWP2006_Production ;
    rdfs:comment "Actress; plays Emily in the 2006 film." .

tdwp:Frame_ClassAndLabour a tdwp:ConceptualInterpretiveFrame ;
    rdfs:label "Class labour and exploitation"@en,
        "Class, labour and exploitation"@en ;
    rdfs:comment "Reading the film through lens of labour exploitation in luxury industries.",
        "Reading the film through lens of labour exploitation"@en .

tdwp:Frame_WorkplaceAbuse a tdwp:FeministFrame ;
    rdfs:label "Workplace abuse and toxic leadership"@en ;
    rdfs:comment "Post-#MeToo frame: Miranda as symbol of abusive power.",
        "Post-MeToo frame — Miranda as symbol of abusive power"@en .

tdwp:HistoricalShift a owl:Class ;
    rdfs:label "Historical Shift"@en ;
    rdfs:comment "A reception shift triggered by a major historical event." ;
    rdfs:subClassOf tdwp:ReceptionShift .

tdwp:LaurenWeisberger a dul:NaturalPerson ;
    rdfs:label "Lauren Weisberger"@en ;
    creon:hasAgent tdwp:Weisberger_NovelWriting ;
    rdfs:comment "Author of the 2003 source novel." .

tdwp:MeTooMovement_2017 a tdwp:SocialMovementPress ;
    rdfs:label "#MeToo cultural shift (2017)"@en ;
    rdfs:comment "Social movement reshaping how workplace power dynamics are interpreted.",
        "Reshaping how workplace power dynamics are interpreted"@en .

tdwp:NostalgiaFrame a owl:Class ;
    rdfs:label "Nostalgia Frame"@en ;
    rdfs:comment "Interpretation as nostalgic document of a past era." ;
    rdfs:subClassOf tdwp:ConceptualInterpretiveFrame .

tdwp:PostCOVID_Cinema_2021 a tdwp:CulturalPressEvent ;
    rdfs:label "Post-COVID cinema revival (2021)"@en ;
    rdfs:comment "Return to theatrical cinema after pandemic closure; nostalgia for classic films.",
        "Return to theatrical cinema — nostalgia for classic films"@en .

tdwp:ProducerRole a owl:Class ;
    rdfs:label "Producer Role"@en ;
    rdfs:subClassOf tdwp:FilmRole .

tdwp:Reception_2006_Critical a tdwp:CriticalFruitionContext ;
    rdfs:label "Critical reception 2006"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2006_Critics ;
    tdwp:hasReceptionYear "2006"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_MediaSatire ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 ;
    tdwp:precedesContext tdwp:Reception_2010s_SocialMedia .

tdwp:Reception_2026_Critical a tdwp:CriticalFruitionContext ;
    rdfs:label "Critical reception — sequel (2026)"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2026_Critics ;
    tdwp:hasReceptionYear "2026"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_ClassAndLabour ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2026 .

tdwp:Reception_2026_Premiere a tdwp:TheatricalFruitionContext ;
    rdfs:label "Sequel premiere 2026"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2026_Sequel ;
    tdwp:hasReceptionYear "2026"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_MediaSatire ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2026 .

tdwp:Role_Director a tdwp:DirectorRole ;
    rdfs:label "Director"@en .

tdwp:Role_Producer a tdwp:ProducerRole ;
    rdfs:label "Producer"@en .

tdwp:Role_Screenwriter a tdwp:ScreenwriterRole ;
    rdfs:label "Screenwriter"@en .

tdwp:SatireFrame a owl:Class ;
    rdfs:label "Satire Frame"@en ;
    rdfs:comment "Interpretation as social satire of an industry or culture." ;
    rdfs:subClassOf tdwp:ConceptualInterpretiveFrame .

tdwp:ScreenwriterRole a owl:Class ;
    rdfs:label "Screenwriter Role"@en ;
    rdfs:subClassOf tdwp:FilmRole .

tdwp:SocialMediaEra_2010s a tdwp:SocialMediaPress ;
    rdfs:label "Social media rise era (2010s)"@en ;
    rdfs:comment "The rise of Instagram, Twitter, and fashion influencer culture.",
        "Rise of Instagram and fashion influencer culture"@en .

tdwp:SocialMediaFruitionContext a owl:Class ;
    rdfs:label "Social Media Fruition Context"@en ;
    rdfs:comment "Reception and reinterpretation via social media (memes, TikTok, Twitter)." ;
    rdfs:subClassOf tdwp:FruitionContext .

tdwp:SocialMovementShift a owl:Class ;
    rdfs:label "Social Movement Shift"@en ;
    rdfs:comment "A reception shift triggered by a social movement (e.g. #MeToo)." ;
    rdfs:subClassOf tdwp:ReceptionShift .

tdwp:TheatricalAudience a owl:Class ;
    rdfs:label "Theatrical Audience"@en ;
    rdfs:subClassOf tdwp:AudienceType .

tdwp:WendyFinerman a dul:NaturalPerson ;
    rdfs:label "Wendy Finerman"@en ;
    tdwp:hasFilmRole tdwp:Role_Producer ;
    creon:hasAgent tdwp:TDWP2006_Production ;
    rdfs:comment "Producer of The Devil Wears Prada (2006)." .

tdwp:continuesFrom a owl:ObjectProperty ;
    rdfs:label "continues from"@en ;
    rdfs:domain tdwp:SequelProcess ;
    rdfs:range creon:PersonalProcess .

tdwp:fromContext a owl:ObjectProperty ;
    rdfs:label "from context"@en ;
    rdfs:domain tdwp:ReceptionShift ;
    rdfs:range tdwp:FruitionContext .

tdwp:hasAudienceAgent a owl:ObjectProperty ;
    rdfs:label "has audience agent"@en ;
    rdfs:domain tdwp:FruitionContext ;
    rdfs:range dul:Agent .

tdwp:hasReceptionContext a owl:ObjectProperty ;
    rdfs:label "has reception context"@en ;
    rdfs:domain creon:CreativeProduct ;
    rdfs:range tdwp:FruitionContext .

tdwp:interpretsFruitionOf a owl:ObjectProperty ;
    rdfs:label "interprets fruition of"@en ;
    rdfs:domain tdwp:FruitionContext ;
    rdfs:range creon:CreativeProduct ;
    owl:inverseOf tdwp:hasReceptionContext .

tdwp:isSequelOf a owl:ObjectProperty ;
    rdfs:label "is sequel of"@en ;
    rdfs:domain tdwp:FashionFilmSequel ;
    rdfs:range tdwp:FashionFilm .

tdwp:shiftsInterpretationOf a owl:ObjectProperty ;
    rdfs:label "shifts interpretation of"@en ;
    rdfs:domain tdwp:ReceptionShift ;
    rdfs:range creon:CreativeProduct .

tdwp:toContext a owl:ObjectProperty ;
    rdfs:label "to context"@en ;
    rdfs:domain tdwp:ReceptionShift ;
    rdfs:range tdwp:FruitionContext .

tdwp:AlineBroshMcKenna a dul:NaturalPerson ;
    rdfs:label "Aline Brosh McKenna"@en ;
    tdwp:hasFilmRole tdwp:Role_Screenwriter ;
    creon:hasAgent tdwp:TDWP2006_Production,
        tdwp:TDWP2026_Production ;
    rdfs:comment "American screenwriter; wrote both TDWP 2006 and 2026." .

tdwp:AnneHathaway a dul:NaturalPerson ;
    rdfs:label "Anne Hathaway"@en ;
    tdwp:hasFilmRole tdwp:Role_LeadActor ;
    creon:hasAgent tdwp:TDWP2006_Production,
        tdwp:TDWP2026_Production ;
    rdfs:comment "Actress; plays Andy Sachs in both films." .

tdwp:Audience_2026_Sequel a tdwp:StreamingAudience ;
    rdfs:label "Contemporary streaming audience 2026"@en ;
    rdfs:comment "Audiences watching sequel on streaming platform"@en .

tdwp:DavidFrankel a dul:NaturalPerson ;
    rdfs:label "David Frankel"@en ;
    tdwp:hasFilmRole tdwp:Role_Director ;
    creon:hasAgent tdwp:TDWP2006_Production,
        tdwp:TDWP2026_Production ;
    rdfs:comment "American film director; directed both TDWP 2006 and 2026." .

tdwp:FashionFilmSequel a owl:Class ;
    rdfs:label "Fashion Film Sequel"@en ;
    rdfs:comment "A fashion film that is a sequel to an existing fashion film." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:isSequelOf ],
        tdwp:FashionFilm .

tdwp:FeministFrame a owl:Class ;
    rdfs:label "Feminist Interpretive Frame"@en ;
    rdfs:comment "Interpretation through feminist critical theory lens." ;
    rdfs:subClassOf tdwp:ConceptualInterpretiveFrame .

tdwp:Frame_AmbitionAndSuccess a tdwp:CareerNarrativeFrame ;
    rdfs:label "Ambition and the price of success"@en ;
    rdfs:comment "Dominant 2006 frame: personal cost of career ambition.",
        "Dominant 2006 frame — personal cost of career ambition"@en .

tdwp:Frame_MediaSatire a tdwp:SatireFrame ;
    rdfs:label "Satire of fashion media culture"@en ;
    rdfs:comment "Academic/critical frame: film as satire of luxury fashion journalism.",
        "Academic frame — film as satire of luxury fashion journalism"@en .

tdwp:Frame_NostalgiaForPrintEra a tdwp:NostalgiaFrame ;
    rdfs:label "Nostalgia for the print media era"@en ;
    rdfs:comment "Post-2026 frame: 2006 film as document of a vanishing world.",
        "2006 film as document of a vanishing media world"@en .

tdwp:HollywoodFilmIndustry a dul:SocialObject ;
    rdfs:label "Hollywood Film Industry"@en ;
    rdfs:comment "The US mainstream film production and distribution system"@en .

tdwp:MerylStreep a dul:NaturalPerson ;
    rdfs:label "Meryl Streep"@en ;
    tdwp:hasFilmRole tdwp:Role_LeadActor ;
    creon:hasAgent tdwp:TDWP2006_Production,
        tdwp:TDWP2026_Production ;
    rdfs:comment "Actress; plays Miranda Priestly in both films." .

tdwp:PrintMediaPress a owl:Class ;
    rdfs:label "Print Media Press"@en ;
    rdfs:comment "CreativityPress characterized by print media dominance." ;
    rdfs:subClassOf tdwp:MediaIndustryPress .

tdwp:Reception_2006_Theatrical a tdwp:TheatricalFruitionContext ;
    rdfs:label "Theatrical release 2006"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2006_Theatrical ;
    tdwp:hasReceptionYear "2006"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_AmbitionAndSuccess ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 .

tdwp:RevivalSequel a owl:Class ;
    rdfs:label "Revival Sequel Process"@en ;
    rdfs:comment "A sequel that revives a franchise after a long hiatus (10+ years)." ;
    rdfs:subClassOf tdwp:SequelProcess .

tdwp:SocialMediaPress a owl:Class ;
    rdfs:label "Social Media Press"@en ;
    rdfs:comment "CreativityPress characterized by social media culture and virality." ;
    rdfs:subClassOf tdwp:MediaIndustryPress .

tdwp:SocialMovementPress a owl:Class ;
    rdfs:label "Social Movement Press"@en ;
    rdfs:comment "A social movement acting as CreativityPress (e.g. #MeToo, #OscarsSoWhite)." ;
    rdfs:subClassOf tdwp:CulturalPressEvent .

tdwp:StanleyTucci a dul:NaturalPerson ;
    rdfs:label "Stanley Tucci"@en ;
    tdwp:hasFilmRole tdwp:Role_LeadActor ;
    creon:hasAgent tdwp:TDWP2006_Production,
        tdwp:TDWP2026_Production ;
    rdfs:comment "Actor; plays Nigel in both films." .

tdwp:StreamingAudience a owl:Class ;
    rdfs:label "Streaming Audience"@en ;
    rdfs:subClassOf tdwp:AudienceType .

tdwp:StreamingFruitionContext a owl:Class ;
    rdfs:label "Streaming Fruition Context"@en ;
    rdfs:comment "Reception via streaming platform (e.g. Disney+)." ;
    rdfs:subClassOf tdwp:FruitionContext .

tdwp:StreamingIndustry a dul:SocialObject ;
    rdfs:label "Streaming Industry"@en ;
    rdfs:comment "The social domain of streaming platforms (Netflix, Disney+, etc.).",
        "Netflix Disney+ and other streaming platforms"@en .

tdwp:StreamingMediaPress a owl:Class ;
    rdfs:label "Streaming Media Press"@en ;
    rdfs:comment "CreativityPress characterized by streaming platform dominance." ;
    rdfs:subClassOf tdwp:MediaIndustryPress .

tdwp:TDWP_SourceNovel a tdwp:SourceNovel ;
    rdfs:label "The Devil Wears Prada — Novel (2003)"@en ;
    tdwp:hasReleaseYear "2003"^^xsd:gYear ;
    tdwp:producedBy tdwp:Weisberger_NovelWriting ;
    rdfs:comment "Lauren Weisberger's 2003 roman à clef about Anna Wintour." .

tdwp:TechnologicalShift a owl:Class ;
    rdfs:label "Technological Shift"@en ;
    rdfs:comment "A reception shift triggered by a change in media technology (e.g. streaming)." ;
    rdfs:subClassOf tdwp:ReceptionShift .

tdwp:TheatricalFruitionContext a owl:Class ;
    rdfs:label "Theatrical Fruition Context"@en ;
    rdfs:comment "Reception in theatrical / cinema release setting." ;
    rdfs:subClassOf tdwp:FruitionContext .

tdwp:CriticalAudience a owl:Class ;
    rdfs:label "Critical Audience"@en ;
    rdfs:comment "Journalists, academics, film critics." ;
    rdfs:subClassOf tdwp:AudienceType .

tdwp:CriticalFruitionContext a owl:Class ;
    rdfs:label "Critical Fruition Context"@en ;
    rdfs:comment "Academic or journalistic critical reception of a film." ;
    rdfs:subClassOf tdwp:FruitionContext .

tdwp:CulturalPressEvent a owl:Class ;
    rdfs:label "Cultural Press Event"@en ;
    rdfs:comment "A social or cultural event that acts as CreativityPress on reception." ;
    rdfs:subClassOf creon:CreativityPress .

tdwp:PrintMediaEra_2004 a tdwp:PrintMediaPress ;
    rdfs:label "Print media dominance era (2004)"@en ;
    rdfs:comment "Pre-streaming era: print fashion magazines at peak influence.",
        "Pre-streaming era — Vogue at peak influence"@en .

tdwp:Reception_2026_PostSequel a tdwp:StreamingFruitionContext ;
    rdfs:label "Post-sequel re-viewing (2026)"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2026_Sequel ;
    tdwp:hasReceptionYear "2026"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_NostalgiaForPrintEra ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 .

tdwp:SequelProcess a owl:Class ;
    rdfs:label "Sequel Creative Process"@en ;
    rdfs:comment """A PersonalProcess revisiting a prior PersonalProcess
    under a new CreativityPress context."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:continuesFrom ],
        creon:PersonalProcess .

tdwp:SourceNovel a owl:Class ;
    rdfs:label "Source Novel"@en ;
    rdfs:comment "A literary novel that serves as the source material for a film adaptation." ;
    rdfs:subClassOf creon:CreativeProduct .

tdwp:StreamingEra_2024 a tdwp:StreamingMediaPress ;
    rdfs:label "Streaming and digital disruption era (2024)"@en ;
    rdfs:comment "Era of streaming dominance, print magazine collapse, TikTok fashion.",
        "Disney+ dominance — print magazine collapse"@en .

tdwp:TDWP_Film_2026 a tdwp:FashionFilmSequel ;
    rdfs:label "The Devil Wears Prada 2 (2026)"@en ;
    tdwp:hasDistributionChannel tdwp:StreamingEra_2024 ;
    tdwp:hasDurationMinutes 118 ;
    tdwp:hasReceptionContext tdwp:Reception_2026_Critical,
        tdwp:Reception_2026_Premiere ;
    tdwp:hasReleaseYear "2026"^^xsd:gYear ;
    tdwp:isSequelOf tdwp:TDWP_Film_2006 ;
    tdwp:producedBy tdwp:TDWP2026_Production ;
    rdfs:comment "The sequel film. Explicitly addresses media transformation." .

tdwp:Weisberger_NovelWriting a creon:PersonalProcess ;
    rdfs:label "Weisberger Novel Writing 2002-2003"@en,
        "Weisberger — Novel Writing (2002–2003)"@en ;
    creon:hasAgent tdwp:LaurenWeisberger ;
    creon:hasPress tdwp:PrintMediaEra_2004 .

tdwp:AudienceType a owl:Class ;
    rdfs:label "Audience Type"@en ;
    rdfs:comment "A typed audience collective in a FruitionContext." ;
    rdfs:subClassOf dul:CollectiveAgent .

tdwp:MediaIndustryPress a owl:Class ;
    rdfs:label "Media Industry Press"@en ;
    rdfs:comment "Structural changes in the media/entertainment industry." ;
    rdfs:subClassOf creon:CreativityPress .

tdwp:Reception_2010s_SocialMedia a tdwp:SocialMediaFruitionContext ;
    rdfs:label "Social media recontextualisation (2010s)"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_2010s_Millennials ;
    tdwp:hasReceptionYear "2012"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_AmbitionAndSuccess ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 ;
    tdwp:precedesContext tdwp:Reception_2017_PostMeToo .

tdwp:Reception_2017_PostMeToo a tdwp:CriticalFruitionContext ;
    rdfs:label "Post-MeToo re-reading (2017)"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_PostMeToo ;
    tdwp:hasReceptionYear "2017"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_WorkplaceAbuse ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 ;
    tdwp:precedesContext tdwp:Reception_2021_PostCOVID .

tdwp:Reception_2021_PostCOVID a tdwp:StreamingFruitionContext ;
    rdfs:label "Post-COVID streaming rewatch (2021)"@en ;
    tdwp:hasAudienceAgent tdwp:Audience_PostCOVID ;
    tdwp:hasReceptionYear "2021"^^xsd:gYear ;
    tdwp:interpretedThrough tdwp:Frame_NostalgiaForPrintEra ;
    tdwp:interpretsFruitionOf tdwp:TDWP_Film_2006 ;
    tdwp:precedesContext tdwp:Reception_2026_PostSequel .

tdwp:Role_LeadActor a tdwp:ActorRole ;
    rdfs:label "Lead Actor"@en .

tdwp:FashionIndustry a dul:SocialObject ;
    rdfs:label "Fashion Industry"@en ;
    rdfs:comment "The social domain of haute couture and fashion journalism.",
        "Domain of haute couture and fashion journalism"@en .

tdwp:FilmRole a owl:Class ;
    rdfs:label "Film Role"@en ;
    rdfs:comment "A professional role in a film production." ;
    rdfs:subClassOf dul:SocialObject .

tdwp:ConceptualInterpretiveFrame a owl:Class ;
    rdfs:label "Conceptual Interpretive Frame"@en ;
    rdfs:comment "A conceptual frame organizing interpretation of a CreativeProduct." ;
    rdfs:subClassOf creon:MetaConvergence .

tdwp:FashionFilm a owl:Class ;
    rdfs:label "Fashion Film"@en ;
    rdfs:comment "A film whose primary creative domain is the fashion industry." ;
    rdfs:subClassOf creon:CreativeProduct .

tdwp:TDWP2026_Production a tdwp:RevivalSequel ;
    rdfs:label "TDWP 2 Production 2026"@en,
        "TDWP 2 — Production (2026)"@en ;
    tdwp:continuesFrom tdwp:TDWP2006_Production ;
    tdwp:hasBudgetUSD 100000000 ;
    tdwp:hasProductionYear "2024"^^xsd:gYear ;
    tdwp:hasSocialDomain tdwp:FashionIndustry,
        tdwp:HollywoodFilmIndustry,
        tdwp:StreamingIndustry ;
    creon:hasAgent tdwp:AlineBroshMcKenna,
        tdwp:AnneHathaway,
        tdwp:DavidFrankel,
        tdwp:MerylStreep,
        tdwp:StanleyTucci ;
    creon:hasPress tdwp:StreamingEra_2024 .

tdwp:ReceptionShift a owl:Class ;
    rdfs:label "Reception Shift"@en ;
    rdfs:comment """An event marking a change in the dominant interpretive
    frame of a CreativeProduct, driven by CreativityPress."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:shiftsInterpretationOf ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:fromContext ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:toContext ],
        dul:Event .

tdwp:TDWP2006_Production a creon:PersonalProcess ;
    rdfs:label "TDWP Production 2006"@en,
        "TDWP — Production (2006)"@en ;
    tdwp:hasBudgetUSD 35000000 ;
    tdwp:hasProductionYear "2004"^^xsd:gYear ;
    tdwp:hasSocialDomain tdwp:FashionIndustry,
        tdwp:HollywoodFilmIndustry ;
    creon:hasAgent tdwp:AlineBroshMcKenna,
        tdwp:AnneHathaway,
        tdwp:DavidFrankel,
        tdwp:EmilyBlunt,
        tdwp:MerylStreep,
        tdwp:StanleyTucci,
        tdwp:WendyFinerman ;
    creon:hasPress tdwp:PrintMediaEra_2004 .

tdwp:TDWP_Film_2006 a tdwp:FashionFilm ;
    rdfs:label "The Devil Wears Prada (2006)"@en ;
    tdwp:adaptedFrom tdwp:TDWP_SourceNovel ;
    tdwp:hasBoxOfficeUSD 326760000 ;
    tdwp:hasDistributionChannel tdwp:PrintMediaEra_2004 ;
    tdwp:hasDurationMinutes 109 ;
    tdwp:hasReceptionContext tdwp:Reception_2006_Critical,
        tdwp:Reception_2006_Theatrical,
        tdwp:Reception_2010s_SocialMedia,
        tdwp:Reception_2017_PostMeToo,
        tdwp:Reception_2021_PostCOVID,
        tdwp:Reception_2026_PostSequel ;
    tdwp:hasReleaseYear "2006"^^xsd:gYear ;
    tdwp:producedBy tdwp:TDWP2006_Production ;
    rdfs:comment "The original film. Opera aperta: meaning evolves across reception contexts." .

tdwp:FruitionContext a owl:Class ;
    rdfs:label "Fruition Context"@en ;
    rdfs:comment """A situated context in which a CreativeProduct is
    experienced and interpreted by an audience, temporally and socially
    independent of the PersonalProcess that created it."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:hasAudienceAgent ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty tdwp:interpretsFruitionOf ],
        creon:CreativitySituation .

[] a owl:AllDisjointClasses ;
    owl:members ( tdwp:ReceptionShift creon:CreativeProduct ) .

[] a owl:AllDisjointClasses ;
    owl:members ( tdwp:FashionFilm tdwp:SourceNovel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( tdwp:DirectSequel tdwp:RevivalSequel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( tdwp:PrintMediaPress tdwp:StreamingMediaPress tdwp:SocialMediaPress ) .

[] a owl:AllDisjointClasses ;
    owl:members ( tdwp:FruitionContext creon:PersonalProcess ) .

